<fieldset class="character-fortune">
  <legend>Fortune</legend>
  <div
    class="fortune-container"
    fxLayout="column"
    fxLayoutAlign="start stretch"
    fxLayoutGap="4px"
  >
    <span class="label">Refreshing</span>
    <div class="fortune-boxes">
      <div class="fortune-box used"></div>
      <div class="fortune-box available"></div>
      <div class="fortune-box available"></div>
      <div class="fortune-box over-max"></div>
      <div class="fortune-box over-max"></div>
    </div>

    <span class="label">Single use</span>
    <div class="fortune-boxes">
      <div class="fortune-box available"></div>
      <div class="fortune-box over-max"></div>
      <div class="fortune-box over-max"></div>
      <div class="fortune-box over-max"></div>
      <div class="fortune-box over-max"></div>
    </div>
  </div>
</fieldset>