<header class="sheet-header">
    <div fxLayout="row" fxLayoutAlign="start bottom">
        <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />

        <div fxLayout="column" fxLayoutAlign="start stretch" fxLayoutGap="8px" fxFlex>
            {{!-- first data row --}}
            <div fxLayout="row" fxLayoutAlign="start bottom" fxLayoutGap="8px">
                <fieldset class="single-field" fxFlex>
                    <legend>Name</legend>
                    <span class="content">Tiberius Gaius Rodus</span>
                </fieldset>

                <fieldset class="single-field">
                    <legend>Culture</legend>
                    <span class="content">Roman Citizen</span>
                </fieldset>

                <fieldset class="single-field">
                    <legend>Caste</legend>
                    <span class="content">Plebian / Freedman</span>
                </fieldset>

                <fieldset class="single-field fixed">
                    <legend>Wealth</legend>
                    <span class="content">2</span>
                </fieldset>
            </div>

            {{!-- second data row --}}
            <div fxLayout="row" fxLayoutAlign="start bottom" fxLayoutGap="8px">
                <fieldset class="single-field" fxFlex>
                    <legend>Archetype</legend>
                    <span class="content">Soldier / Legionary</span>
                </fieldset>

                <fieldset class="single-field" fxFlex>
                    <legend>Background</legend>
                    <span class="content">Campaign Veteran</span>
                </fieldset>

                <fieldset class="single-field" fxFlex>
                    <legend>Characteristic</legend>
                    <span class="content">Atlantean Ancestry</span>
                </fieldset>
            </div>
        </div>
    </div>

    {{!-- third data row --}}
    <div fxLayout="row" fxLayoutAlign="start bottom" fxLayoutGap="8px">
        <fieldset>
            <legend>Truths</legend>
            <div class="chip-container">
                <div class="chip">
                    <span>Roman Citizen</span>
                    <div>X</div>
                </div>
                <div class="chip">
                    <span>Campaign Veteran</span>
                    <div>X</div>
                </div>
                <div class="chip">
                    <span>Atlantean Ancestry</span>
                    <div>X</div>
                </div>
            </div>
        </fieldset>

        {{> characterStressChart }}

        <div fxLayout="column" fxLayoutAlign="start stretch" fxLayoutGap="4px">
            <fieldset class="fixed" fxFlex>
                <legend>Armor</legend>
                <span class="content">5</span>
            </fieldset>
            <fieldset class="fixed" fxFlex>
                <legend>Courage</legend>
                <span class="content">1</span>
            </fieldset>
        </div>
    </div>
    
    {{!-- fourth data row --}}
        <div fxLayout="row" fxLayoutAlign="start bottom" fxLayoutGap="8px">
        <fieldset fxFlex>
            <legend>Injuries</legend>
            <div class="chip-container">
                <div class="chip">
                    <span>Coup de lance à l'abdomen (P)</span>
                    <div>X</div>
                </div>
                <div class="chip">
                    <span>Peur (M)</span>
                    <div>X</div>
                </div>
                <div class="chip">
                    <span>Cheville foulée (P)</span>
                    <div>X</div>
                </div>
            </div>
        </fieldset>

        <fieldset fxFlex>
            <legend>Scars</legend>
            <div class="chip-container">
                <div class="chip">
                    <span>Douleur chronique (P)</span>
                    <div>X</div>
                </div>
                <div class="chip">
                    <span>Obsession: Gladius de la campagne de Mythilène</span>
                    <div>X</div>
                </div>
                <div class="chip">
                    <span>Cicatrice caractéristique (P)</span>
                    <div>X</div>
                </div>
            </div>
        </fieldset>

        {{> characterFortune }}
    </div>
</header>