<div class="cc-keyword-list">
  <legend class="table-header-01">
    <span>Keywords</span>
    {{#if editable}}
    <button class="ui-button add-keyword" title="Add new keyword">+</button>
    {{/if}}
  </legend>
  {{#if editable}}
  <ul>
    {{#each context}}
      <li>
        <input
          name="{{../target}}.{{@index}}"
          type="text"
          value="{{this}}"
          placeholder="Keyword"
          {{#if (lookup ../contextValidation @index)}}
          class="error"
          {{/if}}
        />
        <button class="ui-button delete-keyword" data-index="{{@index}}" title="Remove keyword">-</button>
      </li>
    {{/each}}
  </ul>
  {{else}}
  <div class="chip-container">
    {{#each context}}
    <div class="chip">
        <span>{{this}}</span>
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>