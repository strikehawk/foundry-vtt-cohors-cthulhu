<header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" {{#if editable}}data-edit="img"{{/if}} title="{{item.name}}" />
    <div class="header-fields">
        <div class="flex" fxLayout="column" fxLayoutAlign="start stretch" fxLayoutGap="8px">
            {{> textInput name="name" class="single-field" label=itemType value=item.name placeholder="Talent" }}
            {{#if showTag}}
            {{> textInput name="system.tag" class="single-field" label="Tag" value=system.tag placeholder="Tag" }}
            {{/if}}
        </div>
    </div>
</header>